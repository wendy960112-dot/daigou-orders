# 複製這份檔案的內容到主機的環境變數。不要把真的密鑰提交到 Git。

# 正式環境必填。請用一長串隨機文字（至少 16 字）。
SESSION_SECRET=

# 網站對外網址，不要以斜線結尾。本機試用可以不填。
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LINE Login 頻道。本機用試用登入時可以先留空。
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CALLBACK_URL=http://localhost:3000/api/auth/line/callback

# 選填。溫蒂的 LINE user id，多個人用逗號分隔。
# 留空時，第一個帳號（LINE 或電子郵件，當時還沒有管理員）會成為管理員。
ADMIN_LINE_USER_IDS=

# 選填。這些信箱註冊或登入時直接成為管理員，不會自動降級。
ADMIN_EMAILS=

# 選填。沒填 SMTP_HOST 或 SMTP_FROM 就不會寄信（預設）。
# 沒有寄信時，請管理員在「幫手」頁產生一次性重設連結。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 選填。資料庫檔與上傳圖片的位置。正式環境請指到永久磁碟。
DATABASE_PATH=./data/daigou.db
UPLOAD_DIR=./data/uploads

# 試用登入。只有「開發模式」而且這個值剛好是 true 才會開啟。
# 正式環境（NODE_ENV=production）一律關閉，就算設成 true 也不會出現。
DEV_LOGIN_ENABLED=true
